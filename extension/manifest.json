{
  "manifest_version": 3,
  "name": "KindBeamer",
  "version": "1.4.0",
  "description": "Beam the article you are reading to your Kindle — extracted, with its images, sent straight to Amazon.",
  "homepage_url": "https://github.com/jooray/kindbeamer",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Beam to Kindle",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" }
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.amazon.com/*"],
  "optional_host_permissions": ["<all_urls>"]
}
