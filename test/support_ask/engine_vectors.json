{
  "about": "Each case replays events against the engine and checks shouldAsk at the 'ask' steps. Events: launch(day), action(n), shown(day), tapped, declined. 'ask' steps carry ctx and the expected answer.",
  "trigger": {
    "minDays": 3,
    "minActions": 3,
    "cooldownDays": [
      14,
      45
    ],
    "maxAsks": 3
  },
  "cases": [
    {
      "name": "a brand new user is never asked",
      "steps": [
        [
          "launch",
          "2026-11-01"
        ],
        [
          "action",
          5
        ],
        [
          "ask",
          {
            "today": "2026-11-01",
            "momentOfValue": true
          },
          false
        ]
      ]
    },
    {
